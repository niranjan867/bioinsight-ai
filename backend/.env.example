# BioInsight AI Backend Environment Configuration (Example)
# Copy to .env and fill in your actual credentials. Never commit .env to source control.

APP_NAME=BioInsight AI
APP_ENV=development
DEBUG=true

# Database: PostgreSQL with psycopg3 driver
DATABASE_URL=postgresql+psycopg://bioinsight_app:YOUR_DB_PASSWORD@127.0.0.1:5432/bioinsight_db

# Security & Authentication
JWT_SECRET_KEY=YOUR_SECURE_RANDOM_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# File Storage
STORAGE_PATH=../storage
MAX_UPLOAD_SIZE_MB=25

# Client Origin
FRONTEND_URL=http://localhost:3000

# Optional; required only for NCBI BLAST (NCBI asks callers to provide a contact email).
NCBI_EMAIL=your-email@example.org
NCBI_TOOL=BioInsightAI

